# NoirSound frontend environment template for local development.
# Production frontend builds use same-origin /api through Caddy.

# Real API mode (requires backend to be running)
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:3000/api

# Mock API mode (runs frontend purely with mock data, no backend required)
# VITE_USE_MOCK_API=true

# External catalog uses the real server API and its server-side admin gate.
# No Audius token or beta access allowlist belongs in VITE_* variables.

# Optional official catalog search; server-only, never VITE_ variables.
# Missing credentials disable only that provider, not Audius/native tracks.
YOUTUBE_API_KEY=
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=us
