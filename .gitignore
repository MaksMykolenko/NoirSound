# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules/
dist/
dist-ssr/
build/
coverage/
playwright-report/
test-results/
lint_output.txt
*.local

# Secrets — never commit real env files
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.production.example
.env.*.local

# Private keys / local certificates
*.pem
*.key
*.p12

# Backups (may contain user data)
backups/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Desktop & Rust build artifacts
target/
**/target/
desktop/**/dist/
desktop/**/build/
desktop/**/node_modules/

# Discord Social SDK binaries and archives
vendor/discord-social-sdk/**/*.dylib
vendor/discord-social-sdk/**/*.so
vendor/discord-social-sdk/**/*.dll
vendor/discord-social-sdk/**/*.lib
vendor/discord-social-sdk/**/*.zip
vendor/discord-social-sdk/**/*.tar.gz
vendor/discord-social-sdk/**/*.h
!vendor/discord-social-sdk/README.md
